<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Terraria Pac-Man Arcade</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Pixel Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Press Start 2P', cursive;
            background-color: #08090c;
            color: #fff;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }
        canvas {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            box-shadow: 0 0 25px rgba(0, 230, 255, 0.25);
        }
        .pixel-border {
            border: 4px solid #4a3728;
            box-shadow: inset -4px -4px 0px 0px #261c14, inset 4px 4px 0px 0px #7a5c43;
        }
        .pixel-btn {
            background-color: #5c4033;
            border: 3px solid #9c7a5b;
            box-shadow: inset -3px -3px 0px #38251a, inset 3px 3px 0px #c29d78;
            transition: all 0.1s ease;
        }
        .pixel-btn:hover:not(:disabled) {
            background-color: #735242;
            transform: scale(1.02);
        }
        .pixel-btn:active:not(:disabled) {
            transform: scale(0.98);
            box-shadow: inset 3px 3px 0px #38251a, inset -3px -3px 0px #c29d78;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1a1614;
        }
        ::-webkit-scrollbar-thumb {
            background: #5c4033;
            border: 2px solid #9c7a5b;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-2 sm:p-4 overflow-x-hidden bg-slate-950 text-white">

    <!-- GAME CONTAINER -->
    <div class="w-full max-w-4xl flex flex-col items-center justify-center relative">

        <!-- HEADER UI -->
        <header class="w-full flex justify-between items-center bg-stone-900 border-4 border-amber-900 p-2 sm:p-3 mb-2 rounded-lg shadow-lg text-xs sm:text-sm">
            <div class="flex items-center space-x-2">
                <span class="text-amber-400">SCORE:</span>
                <span id="scoreText" class="text-white">0</span>
            </div>
            <div class="flex items-center space-x-2">
                <span class="text-emerald-400">LVL:</span>
                <span id="levelText" class="text-white">1/40</span>
            </div>
            <div class="flex items-center space-x-1" id="livesContainer">
                <!-- Hearts generated by JS -->
            </div>
            <div class="flex items-center space-x-2">
                <button id="soundToggleBtn" title="Toggle Sound" class="bg-stone-800 hover:bg-stone-700 p-2 rounded border border-amber-700 text-amber-300">🔊</button>
                <button id="pauseBtn" title="Pause Game" class="bg-stone-800 hover:bg-stone-700 px-3 py-2 rounded border border-amber-700 text-amber-300">⏸️</button>
            </div>
        </header>

        <!-- MAIN CANVAS CONTAINER -->
        <div class="relative w-full flex justify-center items-center bg-black rounded-lg border-4 border-stone-800 overflow-hidden shadow-2xl">
            <canvas id="gameCanvas" width="576" height="576" class="max-w-full h-auto object-contain"></canvas>

            <!-- OVERLAYS / MENUS -->
            
            <!-- 1. MAIN MENU -->
            <div id="mainMenu" class="absolute inset-0 bg-stone-950/95 flex flex-col items-center justify-center p-4 z-20">
                <h1 class="text-xl sm:text-3xl text-amber-400 text-center mb-1 tracking-wider drop-shadow-[0_4px_0_#5c4033]">TERRARIA PAC-MAN</h1>
                <p class="text-[10px] sm:text-xs text-cyan-300 mb-4 tracking-wide">ARCADE BIOME EDITION</p>

                <!-- Character Preview Selection -->
                <div class="mb-4 flex space-x-4 items-center">
                    <div id="selectMale" class="flex flex-col items-center cursor-pointer p-2 sm:p-3 border-4 border-amber-400 bg-stone-800 rounded-lg hover:scale-105 transition">
                        <canvas id="malePreviewCanvas" width="40" height="40" class="mb-1"></canvas>
                        <span class="text-[10px] text-amber-200">Terrarian Hero</span>
                    </div>
                    <div id="selectFemale" class="flex flex-col items-center cursor-pointer p-2 sm:p-3 border-4 border-transparent bg-stone-900 rounded-lg opacity-70 hover:opacity-100 hover:scale-105 transition">
                        <canvas id="femalePreviewCanvas" width="40" height="40" class="mb-1"></canvas>
                        <span class="text-[10px] text-pink-300">Terrarian Heroine</span>
                    </div>
                </div>

                <!-- Difficulty Selector -->
                <div class="mb-4 flex flex-col items-center">
                    <span class="text-[10px] text-stone-400 mb-1">DIFFICULTY:</span>
                    <div class="flex space-x-2">
                        <button class="diff-btn text-[10px] px-3 py-1 rounded bg-green-900 border border-green-500 text-green-200" data-diff="easy">EASY</button>
                        <button class="diff-btn text-[10px] px-3 py-1 rounded bg-amber-600 border-2 border-amber-300 text-white font-bold" data-diff="normal">NORMAL</button>
                        <button class="diff-btn text-[10px] px-3 py-1 rounded bg-red-900 border border-red-500 text-red-200" data-diff="hard">HARD</button>
                    </div>
                </div>

                <!-- Menu Buttons -->
                <div class="flex flex-col space-y-2 w-60">
                    <button id="startGameBtn" class="pixel-btn text-amber-200 py-2.5 text-xs font-bold tracking-wider">NEW GAME</button>
                    <button id="loadGameBtn" class="pixel-btn text-cyan-300 py-2.5 text-xs font-bold tracking-wider disabled:opacity-40" disabled>LOAD GAME</button>
                    <button id="leaderboardMenuBtn" class="pixel-btn text-yellow-300 py-2 text-xs">🏆 HIGH SCORES</button>
                    <button id="levelSelectMenuBtn" class="pixel-btn text-emerald-300 py-2 text-xs">SELECT LEVEL</button>
                </div>

                <div class="mt-4 text-[9px] sm:text-[10px] text-stone-400 text-center leading-tight">
                    Collect Stars ⭐ & Life Crystals ❤️<br>
                    Avoid Eyes of Cthulhu & Slimes!
                </div>
            </div>

            <!-- 2. HIGH SCORE / LEADERBOARD MODAL -->
            <div id="leaderboardMenu" class="absolute inset-0 bg-stone-950/95 flex flex-col items-center justify-center p-4 z-30 hidden">
                <h2 class="text-base sm:text-xl text-yellow-400 mb-3 flex items-center space-x-2">
                    <span>🏆 HALL OF FAME</span>
                </h2>
                
                <div class="w-full max-w-md bg-stone-900 border-2 border-amber-700 rounded p-2 mb-4 overflow-x-auto">
                    <table class="w-full text-left text-[10px] sm:text-xs">
                        <thead>
                            <tr class="border-b border-stone-700 text-amber-300">
                                <th class="p-1">#</th>
                                <th class="p-1">NAME</th>
                                <th class="p-1">SCORE</th>
                                <th class="p-1">LVL</th>
                                <th class="p-1 text-right">DATE</th>
                            </tr>
                        </thead>
                        <tbody id="leaderboardTbody">
                            <!-- Rows dynamically populated -->
                        </tbody>
                    </table>
                </div>

                <button id="closeLeaderboardBtn" class="pixel-btn text-white px-6 py-2 text-xs">BACK</button>
            </div>

            <!-- 3. LEVEL SELECT MODAL -->
            <div id="levelSelectMenu" class="absolute inset-0 bg-stone-950/95 flex flex-col items-center justify-center p-4 z-30 hidden">
                <h2 class="text-base sm:text-lg text-emerald-400 mb-3">SELECT LEVEL (1-40)</h2>
                <div id="levelGrid" class="grid grid-cols-5 sm:grid-cols-8 gap-1.5 max-h-60 overflow-y-auto p-2 w-full max-w-lg mb-4 bg-stone-900 border-2 border-stone-700 rounded">
                    <!-- Dynamic Level Buttons -->
                </div>
                <button id="closeLevelSelectBtn" class="pixel-btn text-white px-6 py-2 text-xs">BACK</button>
            </div>

            <!-- 4. PAUSE MODAL -->
            <div id="pauseMenu" class="absolute inset-0 bg-stone-950/85 flex flex-col items-center justify-center p-4 z-30 hidden">
                <h2 class="text-xl sm:text-2xl text-amber-400 mb-6">GAME PAUSED</h2>
                <div class="flex flex-col space-y-3 w-52">
                    <button id="resumeBtn" class="pixel-btn text-green-300 py-2.5 text-xs">RESUME</button>
                    <button id="saveGameBtn" class="pixel-btn text-cyan-300 py-2.5 text-xs">SAVE GAME</button>
                    <button id="quitBtn" class="pixel-btn text-red-400 py-2.5 text-xs">MAIN MENU</button>
                </div>
            </div>

            <!-- 5. GAME OVER / WIN & SCORE ENTRY MODAL -->
            <div id="statusModal" class="absolute inset-0 bg-stone-950/95 flex flex-col items-center justify-center p-4 z-40 hidden">
                <h2 id="statusTitle" class="text-xl sm:text-3xl text-red-500 mb-2 text-center">GAME OVER</h2>
                <p id="statusDesc" class="text-xs text-stone-300 mb-4 text-center">You were defeated by Terraria monsters!</p>
                
                <!-- Score Submit Input -->
                <div id="scoreSubmitBox" class="flex flex-col items-center mb-4 bg-stone-900 p-3 rounded border border-amber-600 w-64">
                    <span class="text-[10px] text-amber-300 mb-2">NEW HIGH SCORE! ENTER NAME:</span>
                    <div class="flex space-x-2">
                        <input type="text" id="playerNameInput" maxlength="5" value="HERO" class="bg-black border border-amber-500 text-center text-amber-200 uppercase px-2 py-1 text-xs w-28 rounded focus:outline-none">
                        <button id="saveScoreBtn" class="pixel-btn text-green-300 px-3 py-1 text-xs">SAVE</button>
                    </div>
                </div>

                <div class="flex space-x-3">
                    <button id="statusRestartBtn" class="pixel-btn text-amber-300 px-4 py-2 text-xs">TRY AGAIN</button>
                    <button id="statusLeaderboardBtn" class="pixel-btn text-yellow-300 px-4 py-2 text-xs">SCORES</button>
                    <button id="statusMenuBtn" class="pixel-btn text-stone-300 px-4 py-2 text-xs">MENU</button>
                </div>
            </div>
        </div>

        <!-- FOOTER & CONTROLS -->
        <footer class="w-full mt-2 flex flex-col sm:flex-row justify-between items-center bg-stone-900 border-2 border-stone-800 p-2.5 rounded-lg text-[10px]">
            <div class="text-stone-400 mb-2 sm:mb-0">
                <span>HIGH SCORE: <strong id="highScoreText" class="text-amber-400">0</strong></span>
                <span class="ml-4">BIOME: <strong id="biomeName" class="text-green-400">Forest Surface</strong></span>
            </div>

            <!-- MOBILE VIRTUAL CONTROLS -->
            <div class="flex flex-col items-center my-1 sm:hidden">
                <div class="grid grid-cols-3 gap-1 w-32 h-32">
                    <div></div>
                    <button id="btnUp" class="bg-stone-800 active:bg-amber-600 border border-stone-600 text-white font-bold rounded flex items-center justify-center text-base">▲</button>
                    <div></div>
                    <button id="btnLeft" class="bg-stone-800 active:bg-amber-600 border border-stone-600 text-white font-bold rounded flex items-center justify-center text-base">◄</button>
                    <div class="bg-stone-950 rounded flex items-center justify-center text-[8px] text-stone-600">DPAD</div>
                    <button id="btnRight" class="bg-stone-800 active:bg-amber-600 border border-stone-600 text-white font-bold rounded flex items-center justify-center text-base">►</button>
                    <div></div>
                    <button id="btnDown" class="bg-stone-800 active:bg-amber-600 border border-stone-600 text-white font-bold rounded flex items-center justify-center text-base">▼</button>
                    <div></div>
                </div>
            </div>

            <div class="text-stone-500 text-center sm:text-right">
                Keyboard: Arrow Keys / WASD
            </div>
        </footer>
    </div>

    <!-- AUDIO & LOGIC -->
    <script>
        // --- AUDIO SYSTEM (Web Audio API Synthesizer) ---
        class SoundFX {
            constructor() {
                this.ctx = null;
                this.enabled = true;
            }
            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }
            playTone(freq, duration, type = 'sine', volume = 0.1) {
                if (!this.enabled || !this.ctx) return;
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                    gain.gain.setValueAtTime(volume, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + duration);
                } catch(e) {}
            }
            chomp() {
                this.playTone(320, 0.05, 'triangle', 0.06);
            }
            powerPellet() {
                this.playTone(600, 0.12, 'square', 0.1);
                setTimeout(() => this.playTone(850, 0.18, 'square', 0.1), 90);
            }
            eatGhost() {
                this.playTone(200, 0.08, 'sawtooth', 0.18);
                setTimeout(() => this.playTone(400, 0.12, 'sawtooth', 0.18), 80);
            }
            death() {
                if (!this.enabled || !this.ctx) return;
                const freqs = [400, 350, 300, 250, 200, 150];
                freqs.forEach((f, i) => {
                    setTimeout(() => this.playTone(f, 0.08, 'sawtooth', 0.12), i * 60);
                });
            }
            win() {
                const freqs = [400, 520, 660, 880];
                freqs.forEach((f, i) => {
                    setTimeout(() => this.playTone(f, 0.1, 'sine', 0.12), i * 80);
                });
            }
        }
        const sfx = new SoundFX();

        // --- CONSTANTS & CONFIG ---
        const GRID_SIZE = 18; // 18x18 grid
        const CANVAS_SIZE = 576; // 576px / 18 = 32px per cell
        const CELL_SIZE = CANVAS_SIZE / GRID_SIZE;

        const DIRECTIONS = {
            NONE: { x: 0, y: 0, angle: 0 },
            UP: { x: 0, y: -1, angle: -Math.PI/2 },
            DOWN: { x: 0, y: 1, angle: Math.PI/2 },
            LEFT: { x: -1, y: 0, angle: Math.PI },
            RIGHT: { x: 1, y: 0, angle: 0 }
        };

        const BIOMES = [
            { name: "Forest Surface", wallColor: "#4a3728", wallBorder: "#2d5a27", bg: "#0d140e", dotColor: "#ffe66d" },
            { name: "Underground Stone", wallColor: "#3a3b3c", wallBorder: "#686a6c", bg: "#111213", dotColor: "#70d6ff" },
            { name: "The Hallow", wallColor: "#59316d", wallBorder: "#d47aff", bg: "#1a0f24", dotColor: "#ff70a6" },
            { name: "Underworld (Hell)", wallColor: "#501212", wallBorder: "#ff4500", bg: "#190505", dotColor: "#ff9f1c" },
            { name: "Dungeon", wallColor: "#1d2a44", wallBorder: "#4169e1", bg: "#080c14", dotColor: "#e0e1dd" }
        ];

        const DIFFICULTY_SETTINGS = {
            easy: { ghostSpeedMultiplier: 0.75, powerDuration: 8000, lives: 4 },
            normal: { ghostSpeedMultiplier: 1.0, powerDuration: 6000, lives: 3 },
            hard: { ghostSpeedMultiplier: 1.25, powerDuration: 4000, lives: 2 }
        };

        // --- GAME STATE ---
        let canvas, ctx;
        let selectedCharacter = 'male'; // 'male' or 'female'
        let currentDifficulty = 'normal';
        let currentLevel = 1;
        let score = 0;
        let highScore = parseInt(localStorage.getItem('terraria_pacman_highscore') || '0');
        let lives = 3;
        let isPaused = false;
        let isGameOver = false;
        let gameLoopReq = null;

        let map = []; // 2D grid array: 1 = wall, 0 = pellet, 2 = power pellet, 3 = empty
        let totalPellets = 0;
        let pelletsEaten = 0;

        // Player state with movement buffer and corner assist
        let player = {
            x: 9, y: 13,
            px: 9 * CELL_SIZE + CELL_SIZE/2,
            py: 13 * CELL_SIZE + CELL_SIZE/2,
            dir: DIRECTIONS.RIGHT,
            nextDir: DIRECTIONS.RIGHT,
            speed: 1.5, // ปรับความเร็วตัวละครลดลงจาก 2.2 เหลือ 1.5 เพื่อให้ควบคุมง่ายและสมดุลขึ้น
            animFrame: 0
        };

        let ghosts = [];
        let powerTimer = null;
        let powerActive = false;

        const GHOST_TYPES = [
            { name: "Eye of Cthulhu", type: "eye", color: "#e63946" },
            { name: "Green Slime", type: "slime", color: "#38b000" },
            { name: "Cave Bat", type: "bat", color: "#7209b7" },
            { name: "Skeleton", type: "skeleton", color: "#d8f3dc" }
        ];

        // --- MAP GENERATION (40 Levels) ---
        function generateMapForLevel(lvl) {
            const size = GRID_SIZE;
            let grid = Array(size).fill(0).map(() => Array(size).fill(1));

            // Outer walls & empty inner grid
            for (let r = 0; r < size; r++) {
                for (let c = 0; c < size; c++) {
                    if (r === 0 || r === size - 1 || c === 0 || c === size - 1) {
                        grid[r][c] = 1;
                    } else {
                        grid[r][c] = 0; // Default pellet
                    }
                }
            }

            // Ghost House in center
            const mid = Math.floor(size / 2);
            for (let r = mid - 2; r <= mid + 1; r++) {
                for (let c = mid - 2; c <= mid + 1; c++) {
                    if (r === mid - 2 || r === mid + 1 || c === mid - 2 || c === mid + 1) {
                        grid[r][c] = 1;
                    } else {
                        grid[r][c] = 3; // Empty space
                    }
                }
            }
            grid[mid - 2][mid] = 3; // Ghost house door

            // Symmetric Maze Obstacles based on Level
            const patternType = (lvl - 1) % 5;
            for (let r = 2; r < mid - 2; r += 2) {
                for (let c = 2; c < mid - 1; c += 2) {
                    const blockVal = ((r * 7 + c * 13 + lvl * 17) % 10);
                    if (blockVal > 3) {
                        grid[r][c] = 1;
                        grid[r][c + 1] = 1;
                        grid[r][size - 1 - c] = 1;
                        grid[r][size - 2 - c] = 1;

                        if (patternType === 1 || patternType === 3) {
                            grid[size - 1 - r][c] = 1;
                            grid[size - 1 - r][c + 1] = 1;
                            grid[size - 1 - r][size - 1 - c] = 1;
                            grid[size - 1 - r][size - 2 - c] = 1;
                        }
                    }
                }
            }

            // Clear Player Spawn Area
            grid[13][8] = 3; grid[13][9] = 3; grid[13][10] = 3;

            // Place Power Pellets near corners
            grid[2][2] = 2;
            grid[2][size - 3] = 2;
            grid[size - 3][2] = 2;
            grid[size - 3][size - 3] = 2;

            // Calculate Total Pellets
            totalPellets = 0;
            for (let r = 0; r < size; r++) {
                for (let c = 0; c < size; c++) {
                    if (grid[r][c] === 0 || grid[r][c] === 2) {
                        totalPellets++;
                    }
                }
            }

            return grid;
        }

        // --- INITIALIZATION ---
        window.addEventListener('load', () => {
            canvas = document.getElementById('gameCanvas');
            ctx = canvas.getContext('2d');

            renderCharacterPreviews();
            setupEventListeners();
            checkSaveData();
            updateUI();
        });

        function setupEventListeners() {
            // Character Selection
            document.getElementById('selectMale').addEventListener('click', () => {
                selectedCharacter = 'male';
                document.getElementById('selectMale').className = "flex flex-col items-center cursor-pointer p-2 sm:p-3 border-4 border-amber-400 bg-stone-800 rounded-lg hover:scale-105 transition";
                document.getElementById('selectFemale').className = "flex flex-col items-center cursor-pointer p-2 sm:p-3 border-4 border-transparent bg-stone-900 rounded-lg opacity-70 hover:opacity-100 hover:scale-105 transition";
            });

            document.getElementById('selectFemale').addEventListener('click', () => {
                selectedCharacter = 'female';
                document.getElementById('selectFemale').className = "flex flex-col items-center cursor-pointer p-2 sm:p-3 border-4 border-pink-400 bg-stone-800 rounded-lg hover:scale-105 transition";
                document.getElementById('selectMale').className = "flex flex-col items-center cursor-pointer p-2 sm:p-3 border-4 border-transparent bg-stone-900 rounded-lg opacity-70 hover:opacity-100 hover:scale-105 transition";
            });

            // Difficulty Toggle
            document.querySelectorAll('.diff-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('border-2', 'border-amber-300', 'font-bold'));
                    e.target.classList.add('border-2', 'border-amber-300', 'font-bold');
                    currentDifficulty = e.target.dataset.diff;
                });
            });

            // Main Menu Buttons
            document.getElementById('startGameBtn').addEventListener('click', () => {
                sfx.init();
                score = 0;
                currentLevel = 1;
                lives = DIFFICULTY_SETTINGS[currentDifficulty].lives;
                startLevel(currentLevel);
                hideAllMenus();
            });

            document.getElementById('loadGameBtn').addEventListener('click', () => {
                sfx.init();
                loadGame();
                hideAllMenus();
            });

            document.getElementById('leaderboardMenuBtn').addEventListener('click', () => {
                showLeaderboard();
            });

            document.getElementById('closeLeaderboardBtn').addEventListener('click', () => {
                document.getElementById('leaderboardMenu').classList.add('hidden');
            });

            document.getElementById('levelSelectMenuBtn').addEventListener('click', () => {
                buildLevelGrid();
                document.getElementById('levelSelectMenu').classList.remove('hidden');
            });

            document.getElementById('closeLevelSelectBtn').addEventListener('click', () => {
                document.getElementById('levelSelectMenu').classList.add('hidden');
            });

            document.getElementById('pauseBtn').addEventListener('click', togglePause);
            document.getElementById('resumeBtn').addEventListener('click', togglePause);
            document.getElementById('saveGameBtn').addEventListener('click', () => {
                saveGame();
                alert("Game Saved Successfully!");
            });

            document.getElementById('quitBtn').addEventListener('click', () => {
                if (gameLoopReq) cancelAnimationFrame(gameLoopReq);
                document.getElementById('pauseMenu').classList.add('hidden');
                document.getElementById('mainMenu').classList.remove('hidden');
            });

            document.getElementById('statusRestartBtn').addEventListener('click', () => {
                hideAllMenus();
                if (lives <= 0) {
                    score = 0;
                    lives = DIFFICULTY_SETTINGS[currentDifficulty].lives;
                    currentLevel = 1;
                }
                startLevel(currentLevel);
            });

            document.getElementById('statusLeaderboardBtn').addEventListener('click', () => {
                hideAllMenus();
                showLeaderboard();
            });

            document.getElementById('statusMenuBtn').addEventListener('click', () => {
                hideAllMenus();
                document.getElementById('mainMenu').classList.remove('hidden');
            });

            document.getElementById('soundToggleBtn').addEventListener('click', (e) => {
                sfx.enabled = !sfx.enabled;
                e.target.innerText = sfx.enabled ? "🔊" : "🔇";
            });

            document.getElementById('saveScoreBtn').addEventListener('click', () => {
                saveHighScoreEntry();
            });

            // Keyboard Controls
            window.addEventListener('keydown', (e) => {
                if (["ArrowUp", "KeyW"].includes(e.code)) player.nextDir = DIRECTIONS.UP;
                if (["ArrowDown", "KeyS"].includes(e.code)) player.nextDir = DIRECTIONS.DOWN;
                if (["ArrowLeft", "KeyA"].includes(e.code)) player.nextDir = DIRECTIONS.LEFT;
                if (["ArrowRight", "KeyD"].includes(e.code)) player.nextDir = DIRECTIONS.RIGHT;
                if (e.code === "KeyP" || e.code === "Escape") togglePause();
            });

            // Touch Controls D-Pad
            const bindTouch = (id, dir) => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.addEventListener('touchstart', (e) => { e.preventDefault(); player.nextDir = dir; });
                    btn.addEventListener('click', () => { player.nextDir = dir; });
                }
            };
            bindTouch('btnUp', DIRECTIONS.UP);
            bindTouch('btnDown', DIRECTIONS.DOWN);
            bindTouch('btnLeft', DIRECTIONS.LEFT);
            bindTouch('btnRight', DIRECTIONS.RIGHT);
        }

        function hideAllMenus() {
            document.getElementById('mainMenu').classList.add('hidden');
            document.getElementById('pauseMenu').classList.add('hidden');
            document.getElementById('levelSelectMenu').classList.add('hidden');
            document.getElementById('leaderboardMenu').classList.add('hidden');
            document.getElementById('statusModal').classList.add('hidden');
        }

        function togglePause() {
            isPaused = !isPaused;
            if (isPaused) {
                document.getElementById('pauseMenu').classList.remove('hidden');
            } else {
                document.getElementById('pauseMenu').classList.add('hidden');
                requestAnimationFrame(gameLoop);
            }
        }

        // --- PREVIEW RENDERING ---
        function renderCharacterPreviews() {
            const renderChar = (canvasId, type) => {
                const cv = document.getElementById(canvasId);
                const cx = cv.getContext('2d');
                cx.clearRect(0, 0, 40, 40);
                drawTerrarianPixel(cx, 20, 20, 36, type, DIRECTIONS.RIGHT, 0);
            };
            renderChar('malePreviewCanvas', 'male');
            renderChar('femalePreviewCanvas', 'female');
        }

        // --- START LEVEL ---
        function startLevel(lvl) {
            currentLevel = lvl;
            map = generateMapForLevel(currentLevel);
            pelletsEaten = 0;
            isGameOver = false;
            isPaused = false;
            powerActive = false;
            if (powerTimer) clearTimeout(powerTimer);

            // Spawn Player centered on cell (9, 13)
            player.x = 9;
            player.y = 13;
            player.px = player.x * CELL_SIZE + CELL_SIZE/2;
            player.py = player.y * CELL_SIZE + CELL_SIZE/2;
            player.dir = DIRECTIONS.RIGHT;
            player.nextDir = DIRECTIONS.RIGHT;

            // Spawn Ghosts (ปรับความเร็วพื้นฐานจาก 1.4 เหลือ 0.95 เพื่อความสมดุลกับ Player)
            const ghostSpeed = 0.95 * DIFFICULTY_SETTINGS[currentDifficulty].ghostSpeedMultiplier;
            ghosts = [
                { x: 8, y: 8, px: 8*CELL_SIZE + CELL_SIZE/2, py: 8*CELL_SIZE + CELL_SIZE/2, dir: DIRECTIONS.UP, type: GHOST_TYPES[0], speed: ghostSpeed, scared: false },
                { x: 9, y: 8, px: 9*CELL_SIZE + CELL_SIZE/2, py: 8*CELL_SIZE + CELL_SIZE/2, dir: DIRECTIONS.UP, type: GHOST_TYPES[1], speed: ghostSpeed * 0.9, scared: false },
                { x: 8, y: 9, px: 8*CELL_SIZE + CELL_SIZE/2, py: 9*CELL_SIZE + CELL_SIZE/2, dir: DIRECTIONS.LEFT, type: GHOST_TYPES[2], speed: ghostSpeed * 1.1, scared: false },
                { x: 9, y: 9, px: 9*CELL_SIZE + CELL_SIZE/2, py: 9*CELL_SIZE + CELL_SIZE/2, dir: DIRECTIONS.RIGHT, type: GHOST_TYPES[3], speed: ghostSpeed * 0.95, scared: false }
            ];

            updateUI();
            if (gameLoopReq) cancelAnimationFrame(gameLoopReq);
            gameLoopReq = requestAnimationFrame(gameLoop);
        }

        // --- MAIN GAME LOOP ---
        function gameLoop() {
            if (isPaused || isGameOver) return;

            updatePlayerPosition();
            updateGhosts();
            render();

            gameLoopReq = requestAnimationFrame(gameLoop);
        }

        // --- SMOOTH CORNERING & MOVEMENT ENGINE ---
        function updatePlayerPosition() {
            player.animFrame += 0.15;

            const speed = player.speed;
            const cornerSnapWindow = 10; // Max pixels allowed to snap alignment around corners

            // Current cell tile index based on center position
            const currentTileX = Math.floor(player.px / CELL_SIZE);
            const currentTileY = Math.floor(player.py / CELL_SIZE);

            // Center pixel coordinate of current cell tile
            const tileCenterX = currentTileX * CELL_SIZE + CELL_SIZE / 2;
            const tileCenterY = currentTileY * CELL_SIZE + CELL_SIZE / 2;

            // Distance to current tile center
            const distToCenterX = player.px - tileCenterX;
            const distToCenterY = player.py - tileCenterY;

            // 1. TRY APPLYING QUEUED DIRECTION CHANGE (BUFFERING & CORNER ASSIST)
            if (player.nextDir !== player.dir) {
                // Determine target tile if turning to nextDir
                let canTurn = false;

                // Reverse direction instantly anywhere
                if (player.nextDir.x === -player.dir.x && player.nextDir.y === -player.dir.y && (player.nextDir.x !== 0 || player.nextDir.y !== 0)) {
                    player.dir = player.nextDir;
                } else {
                    // Check if aligned enough to turn into perpendicular path
                    const checkingTileX = currentTileX + player.nextDir.x;
                    const checkingTileY = currentTileY + player.nextDir.y;

                    if (!isWall(checkingTileX, checkingTileY)) {
                        // Horizontal turn desired (UP/DOWN -> LEFT/RIGHT)
                        if (player.nextDir.x !== 0 && Math.abs(distToCenterY) <= cornerSnapWindow) {
                            player.py = tileCenterY; // Snap alignment perpendicularly
                            player.dir = player.nextDir;
                            canTurn = true;
                        }
                        // Vertical turn desired (LEFT/RIGHT -> UP/DOWN)
                        else if (player.nextDir.y !== 0 && Math.abs(distToCenterX) <= cornerSnapWindow) {
                            player.px = tileCenterX; // Snap alignment perpendicularly
                            player.dir = player.nextDir;
                            canTurn = true;
                        }
                    }
                }
            }

            // 2. MOVE PLAYER IN CURRENT DIRECTION
            let nextPx = player.px + player.dir.x * speed;
            let nextPy = player.py + player.dir.y * speed;

            // Collision check along current path
            const checkX = Math.floor((nextPx + player.dir.x * (CELL_SIZE / 2 - 2)) / CELL_SIZE);
            const checkY = Math.floor((nextPy + player.dir.y * (CELL_SIZE / 2 - 2)) / CELL_SIZE);

            if (isWall(checkX, checkY)) {
                // Stop at cell center when hitting wall
                if (player.dir.x > 0) player.px = Math.min(nextPx, tileCenterX);
                else if (player.dir.x < 0) player.px = Math.max(nextPx, tileCenterX);
                else if (player.dir.y > 0) player.py = Math.min(nextPy, tileCenterY);
                else if (player.dir.y < 0) player.py = Math.max(nextPy, tileCenterY);
            } else {
                player.px = nextPx;
                player.py = nextPy;
            }

            // Update current grid coords
            player.x = Math.floor(player.px / CELL_SIZE);
            player.y = Math.floor(player.py / CELL_SIZE);

            // 3. EAT PELLETS & ITEMS
            if (map[player.y] && map[player.y][player.x] !== 3) {
                const cell = map[player.y][player.x];
                if (cell === 0) { // Fallen Star / Pellet
                    map[player.y][player.x] = 3;
                    score += 10;
                    pelletsEaten++;
                    sfx.chomp();
                } else if (cell === 2) { // Life Crystal (Power Pellet)
                    map[player.y][player.x] = 3;
                    score += 50;
                    pelletsEaten++;
                    triggerPowerPellet();
                    sfx.powerPellet();
                }

                if (score > highScore) {
                    highScore = score;
                    localStorage.setItem('terraria_pacman_highscore', highScore.toString());
                }
                updateUI();

                // Level Completed Check
                if (pelletsEaten >= totalPellets) {
                    sfx.win();
                    if (currentLevel < 40) {
                        currentLevel++;
                        alert(`LEVEL ${currentLevel - 1} CLEARED! Advancing to Level ${currentLevel}`);
                        startLevel(currentLevel);
                    } else {
                        showStatusModal("CONGRATULATIONS!", "You conquered all 40 levels of Terraria Pac-Man!", true);
                    }
                }
            }
        }

        // --- GHOST AI & UPDATES ---
        function updateGhosts() {
            ghosts.forEach(ghost => {
                const gx = Math.floor(ghost.px / CELL_SIZE);
                const gy = Math.floor(ghost.py / CELL_SIZE);
                const tileCenterX = gx * CELL_SIZE + CELL_SIZE / 2;
                const tileCenterY = gy * CELL_SIZE + CELL_SIZE / 2;

                // Turn decision when near center of tile
                if (Math.abs(ghost.px - tileCenterX) < ghost.speed && Math.abs(ghost.py - tileCenterY) < ghost.speed) {
                    const validDirs = Object.values(DIRECTIONS).filter(d => {
                        if (d === DIRECTIONS.NONE) return false;
                        // Avoid 180 u-turn unless dead end
                        if (d.x === -ghost.dir.x && d.y === -ghost.dir.y) return false;
                        return !isWall(gx + d.x, gy + d.y);
                    });

                    if (validDirs.length > 0) {
                        if (ghost.scared) {
                            ghost.dir = validDirs[Math.floor(Math.random() * validDirs.length)];
                        } else {
                            // Target tracking
                            let bestDir = validDirs[0];
                            let minDistance = 999999;
                            validDirs.forEach(d => {
                                const nextX = gx + d.x;
                                const nextY = gy + d.y;
                                const dist = Math.hypot(nextX - player.x, nextY - player.y);
                                if (dist < minDistance) {
                                    minDistance = dist;
                                    bestDir = d;
                                }
                            });
                            ghost.dir = bestDir;
                        }
                    } else {
                        // Reverse if stuck
                        ghost.dir = { x: -ghost.dir.x, y: -ghost.dir.y };
                    }
                }

                const currentSpd = ghost.scared ? ghost.speed * 0.6 : ghost.speed;
                ghost.px += ghost.dir.x * currentSpd;
                ghost.py += ghost.dir.y * currentSpd;

                // Player Collision Check
                const distToPlayer = Math.hypot(ghost.px - player.px, ghost.py - player.py);
                if (distToPlayer < CELL_SIZE * 0.75) {
                    if (ghost.scared || powerActive) {
                        // Eat Ghost
                        sfx.eatGhost();
                        score += 200;
                        ghost.px = 9 * CELL_SIZE + CELL_SIZE/2;
                        ghost.py = 8 * CELL_SIZE + CELL_SIZE/2;
                        ghost.scared = false;
                        updateUI();
                    } else {
                        // Player Defeated
                        sfx.death();
                        lives--;
                        updateUI();
                        if (lives <= 0) {
                            showStatusModal("GAME OVER", `Final Score: ${score}`);
                        } else {
                            // Reset position
                            player.px = 9 * CELL_SIZE + CELL_SIZE/2;
                            player.py = 13 * CELL_SIZE + CELL_SIZE/2;
                            player.dir = DIRECTIONS.RIGHT;
                            player.nextDir = DIRECTIONS.RIGHT;
                        }
                    }
                }
            });
        }

        function triggerPowerPellet() {
            powerActive = true;
            ghosts.forEach(g => g.scared = true);
            if (powerTimer) clearTimeout(powerTimer);
            powerTimer = setTimeout(() => {
                powerActive = false;
                ghosts.forEach(g => g.scared = false);
            }, DIFFICULTY_SETTINGS[currentDifficulty].powerDuration);
        }

        function isWall(x, y) {
            if (x < 0 || x >= GRID_SIZE || y < 0 || y >= GRID_SIZE) return true;
            return map[y][x] === 1;
        }

        // --- RENDERING ---
        function render() {
            const biomeIndex = Math.floor((currentLevel - 1) / 8) % BIOMES.length;
            const currentBiome = BIOMES[biomeIndex];

            // Background
            ctx.fillStyle = currentBiome.bg;
            ctx.fillRect(0, 0, CANVAS_SIZE, CANVAS_SIZE);

            // Draw Map Walls & Items
            for (let r = 0; r < GRID_SIZE; r++) {
                for (let c = 0; c < GRID_SIZE; c++) {
                    const x = c * CELL_SIZE;
                    const y = r * CELL_SIZE;

                    if (map[r][c] === 1) { // Wall block
                        ctx.fillStyle = currentBiome.wallColor;
                        ctx.fillRect(x, y, CELL_SIZE, CELL_SIZE);
                        ctx.strokeStyle = currentBiome.wallBorder;
                        ctx.lineWidth = 2;
                        ctx.strokeRect(x + 2, y + 2, CELL_SIZE - 4, CELL_SIZE - 4);
                    } else if (map[r][c] === 0) { // Star / Pellet
                        drawFallenStar(ctx, x + CELL_SIZE/2, y + CELL_SIZE/2, currentBiome.dotColor);
                    } else if (map[r][c] === 2) { // Life Crystal
                        drawLifeCrystal(ctx, x + CELL_SIZE/2, y + CELL_SIZE/2);
                    }
                }
            }

            // Draw Terrarian Hero/Heroine
            drawTerrarianPixel(ctx, player.px, player.py, CELL_SIZE * 0.9, selectedCharacter, player.dir, player.animFrame);

            // Draw Ghosts
            ghosts.forEach(ghost => {
                if (ghost.scared) {
                    drawBlueSlime(ctx, ghost.px, ghost.py, CELL_SIZE * 0.85);
                } else {
                    drawMonsterPixel(ctx, ghost.px, ghost.py, CELL_SIZE * 0.85, ghost.type);
                }
            });
        }

        // --- DRAW PIXEL ART ASSETS ---
        function drawFallenStar(ctx, cx, cy, color) {
            ctx.save();
            ctx.translate(cx, cy);
            ctx.fillStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = 6;
            ctx.beginPath();
            for (let i = 0; i < 5; i++) {
                ctx.lineTo(Math.cos((18 + i * 72) * Math.PI / 180) * 4.5, -Math.sin((18 + i * 72) * Math.PI / 180) * 4.5);
                ctx.lineTo(Math.cos((54 + i * 72) * Math.PI / 180) * 2.2, -Math.sin((54 + i * 72) * Math.PI / 180) * 2.2);
            }
            ctx.fill();
            ctx.restore();
        }

        function drawLifeCrystal(ctx, cx, cy) {
            ctx.save();
            ctx.translate(cx, cy);
            const pulse = 1 + Math.sin(Date.now() * 0.008) * 0.15;
            ctx.scale(pulse, pulse);
            ctx.fillStyle = "#ff2a6d";
            ctx.shadowColor = "#ff2a6d";
            ctx.shadowBlur = 10;
            ctx.beginPath();
            ctx.arc(-3, -3, 3.5, 0, Math.PI * 2);
            ctx.arc(3, -3, 3.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.moveTo(-6.5, -2);
            ctx.lineTo(0, 6);
            ctx.lineTo(6.5, -2);
            ctx.fill();
            ctx.restore();
        }

        function drawTerrarianPixel(ctx, x, y, size, charType, dir, frame) {
            ctx.save();
            ctx.translate(x, y);

            if (dir === DIRECTIONS.LEFT) {
                ctx.scale(-1, 1);
            }

            const bounce = Math.sin(frame) * 1.5;
            const p = size / 16;

            // Head (Skin)
            ctx.fillStyle = "#ffdbac";
            ctx.fillRect(-4 * p, (-6 + bounce) * p, 8 * p, 6 * p);

            // Eyes
            ctx.fillStyle = "#000";
            ctx.fillRect(1 * p, (-4 + bounce) * p, 2 * p, 2 * p);

            if (charType === 'male') {
                // Copper Helmet / Hair
                ctx.fillStyle = "#8b5a2b";
                ctx.fillRect(-5 * p, (-9 + bounce) * p, 10 * p, 4 * p);
                ctx.fillRect(-5 * p, (-6 + bounce) * p, 3 * p, 4 * p);
                // Armor Body
                ctx.fillStyle = "#b87333";
                ctx.fillRect(-4 * p, (0 + bounce) * p, 8 * p, 5 * p);
            } else {
                // Pink Hair (Terrarian Girl)
                ctx.fillStyle = "#ff69b4";
                ctx.fillRect(-5 * p, (-9 + bounce) * p, 10 * p, 4 * p);
                ctx.fillRect(-6 * p, (-5 + bounce) * p, 3 * p, 7 * p);
                // Blue Tunic Body
                ctx.fillStyle = "#00bfff";
                ctx.fillRect(-4 * p, (0 + bounce) * p, 8 * p, 5 * p);
            }

            // Pants & Boots
            ctx.fillStyle = "#222";
            ctx.fillRect(-4 * p, (5 + bounce) * p, 3 * p, 4 * p);
            ctx.fillRect(1 * p, (5 + bounce) * p, 3 * p, 4 * p);

            ctx.restore();
        }

        function drawMonsterPixel(ctx, x, y, size, monster) {
            ctx.save();
            ctx.translate(x, y);
            const p = size / 16;

            if (monster.type === 'eye') {
                ctx.fillStyle = "#ffffff";
                ctx.beginPath();
                ctx.arc(0, 0, 7 * p, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = "#d00000";
                ctx.beginPath();
                ctx.arc(2 * p, 0, 3.5 * p, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = "#000000";
                ctx.beginPath();
                ctx.arc(3 * p, 0, 1.5 * p, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = "#990000";
                ctx.fillRect(-7 * p, -2 * p, 3 * p, 4 * p);
            } else if (monster.type === 'slime') {
                const squish = Math.sin(Date.now() * 0.01) * 1.5;
                ctx.fillStyle = "#38b000";
                ctx.beginPath();
                ctx.ellipse(0, 2 * p, 7 * p + squish, 5 * p - squish, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = "#ffffff";
                ctx.fillRect(-3 * p, 0, 2 * p, 2 * p);
                ctx.fillRect(1 * p, 0, 2 * p, 2 * p);
            } else if (monster.type === 'bat') {
                ctx.fillStyle = "#4a154b";
                ctx.fillRect(-3 * p, -3 * p, 6 * p, 6 * p);
                const wingY = Math.sin(Date.now() * 0.02) * 4;
                ctx.beginPath();
                ctx.moveTo(-3 * p, 0);
                ctx.lineTo(-8 * p, (-4 + wingY) * p);
                ctx.lineTo(-4 * p, 3 * p);
                ctx.fill();
                ctx.beginPath();
                ctx.moveTo(3 * p, 0);
                ctx.lineTo(8 * p, (-4 + wingY) * p);
                ctx.lineTo(4 * p, 3 * p);
                ctx.fill();
            } else {
                ctx.fillStyle = "#e0e0e0";
                ctx.fillRect(-4 * p, -6 * p, 8 * p, 7 * p);
                ctx.fillStyle = "#000";
                ctx.fillRect(-3 * p, -4 * p, 2 * p, 3 * p);
                ctx.fillRect(1 * p, -4 * p, 2 * p, 3 * p);
            }

            ctx.restore();
        }

        function drawBlueSlime(ctx, x, y, size) {
            ctx.save();
            ctx.translate(x, y);
            const p = size / 16;
            ctx.fillStyle = "#0077b6";
            ctx.beginPath();
            ctx.ellipse(0, 2 * p, 7 * p, 5 * p, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = "#fff";
            ctx.fillRect(-3 * p, -1 * p, 2 * p, 2 * p);
            ctx.fillRect(1 * p, -1 * p, 2 * p, 2 * p);
            ctx.restore();
        }

        // --- LEADERBOARD & HIGH SCORE SYSTEM ---
        function getLeaderboard() {
            const defaultData = [
                { name: "GUIDE", score: 1500, level: 5, date: "2026-03-01" },
                { name: "DRYAD", score: 1200, level: 4, date: "2026-03-02" },
                { name: "ARMOR", score: 800, level: 3, date: "2026-03-03" }
            ];
            const data = localStorage.getItem('terraria_pacman_leaderboard');
            return data ? JSON.parse(data) : defaultData;
        }

        function saveHighScoreEntry() {
            const nameInput = document.getElementById('playerNameInput');
            const name = (nameInput.value || 'HERO').trim().toUpperCase();
            const leaderboard = getLeaderboard();
            
            const newEntry = {
                name: name,
                score: score,
                level: currentLevel,
                date: new Date().toISOString().split('T')[0]
            };

            leaderboard.push(newEntry);
            leaderboard.sort((a, b) => b.score - a.score);
            const topScores = leaderboard.slice(0, 10); // Keep top 10

            localStorage.setItem('terraria_pacman_leaderboard', JSON.stringify(topScores));
            document.getElementById('scoreSubmitBox').classList.add('hidden');
            showLeaderboard();
        }

        function showLeaderboard() {
            const leaderboard = getLeaderboard();
            const tbody = document.getElementById('leaderboardTbody');
            tbody.innerHTML = '';

            leaderboard.forEach((entry, idx) => {
                const tr = document.createElement('tr');
                tr.className = `border-b border-stone-800 ${idx === 0 ? 'text-yellow-400 font-bold' : 'text-stone-300'}`;
                tr.innerHTML = `
                    <td class="p-1">${idx + 1}</td>
                    <td class="p-1">${entry.name}</td>
                    <td class="p-1 text-emerald-400">${entry.score}</td>
                    <td class="p-1">L${entry.level}</td>
                    <td class="p-1 text-right text-[8px] text-stone-500">${entry.date}</td>
                `;
                tbody.appendChild(tr);
            });

            hideAllMenus();
            document.getElementById('leaderboardMenu').classList.remove('hidden');
        }

        // --- SAVE & LOAD GAME SYSTEM ---
        function saveGame() {
            const saveData = {
                level: currentLevel,
                score: score,
                lives: lives,
                character: selectedCharacter,
                difficulty: currentDifficulty
            };
            localStorage.setItem('terraria_pacman_save', JSON.stringify(saveData));
            checkSaveData();
        }

        function loadGame() {
            const raw = localStorage.getItem('terraria_pacman_save');
            if (!raw) return;
            const data = JSON.parse(raw);
            currentLevel = data.level || 1;
            score = data.score || 0;
            lives = data.lives || 3;
            selectedCharacter = data.character || 'male';
            currentDifficulty = data.difficulty || 'normal';

            startLevel(currentLevel);
        }

        function checkSaveData() {
            const hasSave = localStorage.getItem('terraria_pacman_save') !== null;
            document.getElementById('loadGameBtn').disabled = !hasSave;
        }

        // --- UI UPDATES & MODALS ---
        function updateUI() {
            document.getElementById('scoreText').innerText = score;
            document.getElementById('highScoreText').innerText = highScore;
            document.getElementById('levelText').innerText = `${currentLevel}/40`;

            const biomeIndex = Math.floor((currentLevel - 1) / 8) % BIOMES.length;
            document.getElementById('biomeName').innerText = BIOMES[biomeIndex].name;

            // HP Containers
            const heartContainer = document.getElementById('livesContainer');
            heartContainer.innerHTML = '';
            for (let i = 0; i < lives; i++) {
                const heart = document.createElement('span');
                heart.className = 'text-red-500 text-xs sm:text-sm animate-pulse';
                heart.innerText = '❤️';
                heartContainer.appendChild(heart);
            }
        }

        function buildLevelGrid() {
            const grid = document.getElementById('levelGrid');
            grid.innerHTML = '';
            for (let i = 1; i <= 40; i++) {
                const btn = document.createElement('button');
                btn.className = `p-1.5 text-[9px] rounded border ${i === currentLevel ? 'bg-amber-600 border-amber-300 text-white' : 'bg-stone-800 border-stone-600 text-stone-300 hover:bg-stone-700'}`;
                btn.innerText = `L${i}`;
                btn.addEventListener('click', () => {
                    document.getElementById('levelSelectMenu').classList.add('hidden');
                    hideAllMenus();
                    startLevel(i);
                });
                grid.appendChild(btn);
            }
        }

        function showStatusModal(title, desc, isWin = false) {
            isGameOver = true;
            document.getElementById('statusTitle').innerText = title;
            document.getElementById('statusTitle').className = `text-xl sm:text-3xl ${isWin ? 'text-amber-400' : 'text-red-500'} mb-2 text-center`;
            document.getElementById('statusDesc').innerText = desc;

            // Check if score qualifies for High Score leaderboard input
            const leaderboard = getLeaderboard();
            const minScore = leaderboard.length >= 10 ? leaderboard[leaderboard.length - 1].score : 0;
            if (score > minScore || leaderboard.length < 10) {
                document.getElementById('scoreSubmitBox').classList.remove('hidden');
            } else {
                document.getElementById('scoreSubmitBox').classList.add('hidden');
            }

            document.getElementById('statusModal').classList.remove('hidden');
        }
    </script>
